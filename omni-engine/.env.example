# Omni-Engine environment — copy to `.env` and fill in. ALL ARE OPTIONAL:
# the daily pipeline + offline conversation summarizer run with none of these set.

# Smarter conversation summaries (Claude). Without it, the offline heuristic is used.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Audio-call transcription (Whisper). Without it, use --text/--file instead of --audio.
# Get one at https://platform.openai.com
OPENAI_API_KEY=

# Which Claude model the summarizer uses (default: claude-opus-4-8).
OMNI_MODEL=claude-opus-4-8

# Apify — runs the scrapers automatically (no CLI/MCP needed). Get the token at
# https://console.apify.com/account/integrations . Actor ids are username~actorname
# (or the actor id) once you've pushed them with tools/deploy-actors.sh.
APIFY_TOKEN=
APIFY_VECTOR_A=
APIFY_VECTOR_B=
APIFY_VECTOR_C=

# Skip-trace provider (owner name+address -> phone/email). Any licensed provider:
# set the endpoint, your key, and which response fields hold phones/emails.
# Results are cached so you never pay twice. Calls are MANUAL — scrub DNC, honor TCPA.
SKIPTRACE_URL=
SKIPTRACE_API_KEY=
SKIPTRACE_PHONES_PATH=phones
SKIPTRACE_EMAILS_PATH=emails

# Morning digest to your phone. NOTIFY_CHANNEL = telegram | slack | webhook | console
# Telegram is the easiest (free, instant): make a bot with @BotFather, get your chat id.
NOTIFY_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# n8n / CRM webhook endpoints (only if you run with --route). Leave blank to skip.
OMNI_WEBHOOK_DEFAULT=
OMNI_WEBHOOK_HIGH_PRIORITY=
OMNI_WEBHOOK_DEALS_TO_KILL=
OMNI_WEBHOOK_DAILY_DIGEST=
