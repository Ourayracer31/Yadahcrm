{
  "name": "Omni-Engine — Travis Dashboard Intake",
  "_comment": "Importable n8n starter. Receives Omni-Engine webhook events and fans them out by `event`/`channel`. INTERNAL ONLY — these are dashboard/notification nodes; do NOT add any node that contacts a builder/landowner/investor. Point your config endpoints (default/highPriority/newMatches/dealsToKill/dailyDigest) at this Webhook node's URL (use the path or query to distinguish channels).",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "omni", "responseMode": "onReceived", "options": {} },
      "name": "Omni Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "omni-engine"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.event }}",
        "rules": {
          "rules": [
            { "value2": "opportunity.routed", "output": 0 },
            { "value2": "warroom.daily", "output": 1 },
            { "value2": "board.daily", "output": 2 },
            { "value2": "firstcall.recommended", "output": 3 }
          ]
        }
      },
      "name": "Route by event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [520, 300]
    },
    {
      "parameters": { "values": { "string": [{ "name": "note", "value": "Upsert opportunity into CRM dashboard (internal). outreach is always false." }] }, "options": {} },
      "name": "CRM: upsert opportunity",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [820, 160]
    },
    {
      "parameters": { "values": { "string": [{ "name": "note", "value": "Post the daily War Room digest to Travis's dashboard / Slack / email." }] }, "options": {} },
      "name": "Notify: War Room",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [820, 280]
    },
    {
      "parameters": { "values": { "string": [{ "name": "note", "value": "Render the Follow-Up Board markdown to Travis's dashboard." }] }, "options": {} },
      "name": "Notify: Follow-Up Board",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [820, 400]
    },
    {
      "parameters": { "values": { "string": [{ "name": "note", "value": "High-priority push: the one first call to make. Notification to Travis only." }] }, "options": {} },
      "name": "Alert: First Call",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [820, 520]
    }
  ],
  "connections": {
    "Omni Webhook": { "main": [[{ "node": "Route by event", "type": "main", "index": 0 }]] },
    "Route by event": {
      "main": [
        [{ "node": "CRM: upsert opportunity", "type": "main", "index": 0 }],
        [{ "node": "Notify: War Room", "type": "main", "index": 0 }],
        [{ "node": "Notify: Follow-Up Board", "type": "main", "index": 0 }],
        [{ "node": "Alert: First Call", "type": "main", "index": 0 }]
      ]
    }
  }
}
